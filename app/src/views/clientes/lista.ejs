<%- include('../partials/top') %>

<div class="mb-5">
  <h2 class="text-lg font-semibold text-slate-900">Clientes</h2>
  <p class="text-slate-500 text-sm">El correo se muestra enmascarado; "Ver correo" lo revela y queda registrado en la bitácora.</p>
</div>

<% if (revelado) { %>
<div class="card mb-5 border-primary-200 bg-primary-50/50">
  <div class="flex items-start gap-3">
    <%- include('../partials/icon', { name: 'eye', cls: 'w-5 h-5 text-primary-600 mt-0.5 shrink-0' }) %>
    <div>
      <p class="text-sm text-slate-800"><strong class="font-semibold"><%= revelado.nombre_cliente %>:</strong> <%= revelado.correo_cliente %></p>
      <p class="text-xs text-slate-500 mt-1">Esta consulta se registró en la bitácora de auditoría.</p>
    </div>
  </div>
</div>
<% } %>

<div class="card mb-5">
  <h3 class="font-semibold text-slate-900 mb-4">Nuevo cliente</h3>
  <form method="post" action="/clientes" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label for="nombre_cliente" class="field-label">Nombre</label>
      <input id="nombre_cliente" name="nombre_cliente" required class="field-input" />
    </div>
    <div>
      <label for="correo_cliente" class="field-label">Correo</label>
      <input id="correo_cliente" name="correo_cliente" type="email" required class="field-input" />
    </div>
    <button type="submit" class="btn btn-primary">Agregar</button>
  </form>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>Nombre</th><th>Correo (enmascarado)</th><th></th></tr></thead>
    <tbody>
      <% clientes.forEach(c => { %>
      <tr>
        <td class="font-medium text-slate-800"><%= c.nombre_cliente %></td>
        <td><code class="text-xs bg-slate-100 px-1.5 py-0.5 rounded"><%= c.correo_enmascarado %></code></td>
        <td>
          <form method="post" action="/clientes/<%= c.idCliente %>/consultar" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn btn-secondary text-xs px-3 py-1.5"><%- include('../partials/icon', { name: 'eye', cls: 'w-3.5 h-3.5' }) %> Ver correo</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% if (clientes.length === 0) { %><tr><td colspan="3" class="text-sm text-slate-500 text-center py-6">Sin clientes registrados.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/bottom') %>
