<%- include('../partials/top') %>

<h2 class="text-lg font-semibold text-slate-900 mb-5"><%= title %></h2>

<div class="card max-w-2xl">
  <form method="post" action="<%= producto ? '/catalogo/productos/' + producto.idProducto : '/catalogo/productos' %>" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% if (!producto) { %>
      <div>
        <label for="codigo_sku" class="field-label">Código SKU</label>
        <input id="codigo_sku" name="codigo_sku" required class="field-input" />
      </div>
      <div></div>
      <% } %>

      <div>
        <label for="nombre_producto" class="field-label">Nombre</label>
        <input id="nombre_producto" name="nombre_producto" required value="<%= producto ? producto.nombre_producto : '' %>" class="field-input" />
      </div>

      <div>
        <label for="marca_producto" class="field-label">Marca</label>
        <input id="marca_producto" name="marca_producto" required value="<%= producto ? producto.marca_producto : '' %>" class="field-input" />
      </div>

      <div>
        <label for="fk_Categoria" class="field-label">Categoría</label>
        <select id="fk_Categoria" name="fk_Categoria" required class="field-input">
          <% categorias.forEach(c => { %>
            <option value="<%= c.idCategoria %>" <%= producto && producto.fk_Categoria === c.idCategoria ? 'selected' : '' %>><%= c.nombre_categoria %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="fk_Plataforma" class="field-label">Plataforma (opcional)</label>
        <select id="fk_Plataforma" name="fk_Plataforma" class="field-input">
          <option value="">— Ninguna —</option>
          <% plataformas.forEach(pl => { %>
            <option value="<%= pl.idPlataforma %>" <%= producto && producto.fk_Plataforma === pl.idPlataforma ? 'selected' : '' %>><%= pl.nombre_plataforma %></option>
          <% }) %>
        </select>
      </div>

      <div>
        <label for="precio_producto" class="field-label">Precio (Q)</label>
        <input id="precio_producto" name="precio_producto" type="number" step="0.01" min="0.01" required value="<%= producto ? producto.precio_producto : '' %>" class="field-input" />
      </div>

      <% if (producto) { %>
      <div class="flex items-center gap-2 pt-7">
        <input type="checkbox" id="activo" name="activo" value="1" <%= producto.activo ? 'checked' : '' %> class="w-4 h-4 rounded border-slate-300 text-primary-500 focus:ring-primary-500/30" />
        <label for="activo" class="text-sm text-slate-700 mb-0">Activo (visible para la venta)</label>
      </div>
      <% } %>
    </div>

    <div class="flex gap-2 pt-2">
      <button type="submit" class="btn btn-primary">Guardar</button>
      <a class="btn btn-secondary" href="/catalogo/productos">Cancelar</a>
    </div>
  </form>
</div>

<%- include('../partials/bottom') %>
