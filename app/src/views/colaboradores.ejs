<%- include('partials/top') %>

<div class="mb-5">
  <h2 class="text-lg font-semibold text-slate-900">Colaboradores</h2>
  <p class="text-slate-500 text-sm">Personal registrado por sucursal.</p>
</div>

<div class="card mb-5">
  <h3 class="font-semibold text-slate-900 mb-1">Nuevo colaborador</h3>
  <p class="text-xs text-slate-500 mb-4">Esto solo crea el registro de personal. El usuario con el que inicia sesión en el sistema lo crea un administrador aparte (ver README: <code class="text-xs bg-slate-100 px-1 py-0.5 rounded">scripts/seed_app_usuarios.js</code>).</p>
  <form method="post" action="/colaboradores" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div>
      <label for="nombre_colaborador" class="field-label">Nombre</label>
      <input id="nombre_colaborador" name="nombre_colaborador" required class="field-input" />
    </div>
    <div>
      <label for="puesto_colaborador" class="field-label">Puesto</label>
      <input id="puesto_colaborador" name="puesto_colaborador" required class="field-input" />
    </div>
    <div>
      <label for="fk_Sucursal" class="field-label">Sucursal</label>
      <select id="fk_Sucursal" name="fk_Sucursal" required class="field-input">
        <% sucursales.forEach(s => { %><option value="<%= s.idSucursal %>"><%= s.nombre_sucursal %></option><% }) %>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Registrar</button>
  </form>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>Nombre</th><th>Puesto</th><th>Sucursal</th><th>Estado</th><th></th></tr></thead>
    <tbody>
      <% colaboradores.forEach(c => { %>
      <tr>
        <td class="font-medium text-slate-800"><%= c.nombre_colaborador %></td>
        <td><%= c.puesto_colaborador %></td>
        <td><%= c.nombre_sucursal %></td>
        <td><span class="badge <%= c.activo ? 'badge-ok' : 'badge-off' %>"><%= c.activo ? 'Activo' : 'Inactivo' %></span></td>
        <td>
          <% if (c.activo) { %>
          <form method="post" action="/colaboradores/<%= c.idColaborador %>/activo" x-data="confirmModal" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="activo" value="0" />
            <button type="button" @click="open = true" class="btn btn-secondary text-xs px-3 py-1.5">Desactivar</button>
            <div x-show="open" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4">
              <div @click.outside="open = false" class="card max-w-sm w-full">
                <h3 class="font-semibold text-slate-900 mb-1">¿Desactivar a <%= c.nombre_colaborador %>?</h3>
                <p class="text-sm text-slate-500 mb-4">No podrá seguir registrando ventas ni compras. Puedes reactivarlo después.</p>
                <div class="flex justify-end gap-2">
                  <button type="button" @click="open = false" class="btn btn-ghost">Cancelar</button>
                  <button type="submit" class="btn btn-danger">Desactivar</button>
                </div>
              </div>
            </div>
          </form>
          <% } else { %>
          <form method="post" action="/colaboradores/<%= c.idColaborador %>/activo" class="m-0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <input type="hidden" name="activo" value="1" />
            <button type="submit" class="btn btn-secondary text-xs px-3 py-1.5">Activar</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (colaboradores.length === 0) { %><tr><td colspan="5" class="text-sm text-slate-500 text-center py-6">Sin colaboradores registrados.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('partials/bottom') %>
