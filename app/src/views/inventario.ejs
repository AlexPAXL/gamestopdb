<%- include('partials/top') %>

<h2 class="text-lg font-semibold text-slate-900 mb-1">Inventario</h2>
<p class="text-slate-500 text-sm mb-5">
  <% if (rol === 'vendedor') { %>Stock disponible en tu sucursal.<% } else { %>Stock disponible por sucursal.<% } %>
</p>

<% if (rol !== 'vendedor') { %>
<form method="get" x-data="autoSubmit" class="mb-5 max-w-xs">
  <label for="sucursal" class="field-label">Filtrar por sucursal</label>
  <select id="sucursal" name="sucursal" @change="$el.form.submit()" class="field-input">
    <option value="">— Todas —</option>
    <% sucursales.forEach(s => { %>
      <option value="<%= s.idSucursal %>" <%= String(filtro) === String(s.idSucursal) ? 'selected' : '' %>><%= s.nombre_sucursal %></option>
    <% }) %>
  </select>
</form>
<% } %>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr><th>Sucursal</th><th>SKU</th><th>Producto</th><th>Categoría</th><th>Plataforma</th><th>Precio</th><th>Stock</th></tr>
    </thead>
    <tbody>
      <% filas.forEach(f => { %>
      <tr>
        <td><%= f.nombre_sucursal %></td>
        <td><code class="text-xs bg-slate-100 px-1.5 py-0.5 rounded"><%= f.codigo_sku %></code></td>
        <td class="font-medium text-slate-800"><%= f.nombre_producto %></td>
        <td><%= f.nombre_categoria %></td>
        <td><%= f.nombre_plataforma || '—' %></td>
        <td>Q<%= Number(f.precio_producto).toFixed(2) %></td>
        <td><span class="badge <%= f.stock_disponible < 5 ? 'badge-warn' : 'badge-ok' %>"><%= f.stock_disponible %></span></td>
      </tr>
      <% }) %>
      <% if (filas.length === 0) { %><tr><td colspan="7" class="text-sm text-slate-500 text-center py-6">Sin existencias registradas.</td></tr><% } %>
    </tbody>
  </table>
</div>

<%- include('partials/bottom') %>
