<%- include('../partials/top') %>

<h2 class="text-lg font-semibold text-slate-900 mb-1">Nueva venta</h2>
<p class="text-slate-500 mb-5">Vendiendo como <strong class="text-slate-700"><%= contexto.colaboradorNombre %></strong> · <%= contexto.sucursalNombre %></p>

<form method="post" action="/ventas" class="space-y-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <input type="hidden" name="colaborador" value="<%= contexto.colaboradorId %>" />

  <div class="card">
    <h3 class="font-semibold text-slate-900 mb-4">Cliente</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="cliente_id" class="field-label">Cliente existente</label>
        <select id="cliente_id" name="cliente_id" class="field-input">
          <option value="">— Elegir —</option>
          <% clientes.forEach(c => { %><option value="<%= c.idCliente %>"><%= c.nombre_cliente %></option><% }) %>
        </select>
      </div>
      <div></div>
      <div>
        <label class="field-label">...o registra uno nuevo: nombre</label>
        <input name="cliente_nuevo_nombre" class="field-input" />
      </div>
      <div>
        <label class="field-label">Correo del cliente nuevo</label>
        <input name="cliente_nuevo_correo" type="email" class="field-input" />
      </div>
    </div>
  </div>

  <div class="card">
    <h3 class="font-semibold text-slate-900 mb-4">Productos</h3>
    <% if (productos.length === 0) { %>
      <p class="text-sm text-slate-500">No hay existencias registradas en esta sucursal.</p>
    <% } %>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Producto</th><th class="w-32">Cantidad</th></tr></thead>
        <tbody>
          <% for (let i = 0; i < lineas; i++) { %>
          <tr>
            <td>
              <select name="producto" class="field-input">
                <option value="">— Producto —</option>
                <% productos.forEach(p => { %>
                  <option value="<%= p.idProducto %>" <%= p.stock_disponible <= 0 ? 'disabled' : '' %>>
                    <%= p.nombre_producto %> (stock: <%= p.stock_disponible %>, Q<%= Number(p.precio_producto).toFixed(2) %>)
                  </option>
                <% }) %>
              </select>
            </td>
            <td><input type="number" name="cantidad" min="1" placeholder="0" class="field-input" /></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="flex gap-2">
    <button type="submit" class="btn btn-primary">Registrar venta</button>
    <a class="btn btn-secondary" href="/">Cancelar</a>
  </div>
</form>

<%- include('../partials/bottom') %>
