<%- include('../partials/top') %>

<h1>Venta #<%= idVenta %> registrada</h1>
<p class="subtitle"><%= contexto.colaboradorNombre %> · <%= contexto.sucursalNombre %></p>

<div class="card">
  <table>
    <thead><tr><th>Producto</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th></tr></thead>
    <tbody>
      <% let total = 0; %>
      <% recibo.forEach(l => { total += Number(l.subtotal_venta); %>
      <tr>
        <td><%= l.nombre_producto %></td>
        <td><%= l.cantidad %></td>
        <td>Q<%= Number(l.precio_unitario).toFixed(2) %></td>
        <td>Q<%= Number(l.subtotal_venta).toFixed(2) %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <p><strong>Total: Q<%= total.toFixed(2) %></strong></p>
</div>

<p>
  <a class="btn" href="/ventas/nueva<%= contexto.colaboradorId ? '?colaborador=' + contexto.colaboradorId : '' %>">Registrar otra venta</a>
  <a class="btn btn-secondary" href="/">Volver al panel</a>
</p>

<%- include('../partials/bottom') %>
