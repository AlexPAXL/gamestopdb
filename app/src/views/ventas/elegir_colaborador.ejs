<%- include('../partials/top') %>

<h2 class="text-lg font-semibold text-slate-900 mb-1">Nueva venta</h2>
<p class="text-slate-500 mb-5">Tu usuario no está ligado a un colaborador de tienda: elige a nombre de quién se registra la venta.</p>

<div class="table-wrap">
  <table class="data-table">
    <thead><tr><th>Colaborador</th><th>Sucursal</th><th></th></tr></thead>
    <tbody>
      <% colaboradores.forEach(c => { %>
      <tr>
        <td class="font-medium text-slate-800"><%= c.nombre_colaborador %></td>
        <td><%= c.nombre_sucursal %></td>
        <td class="text-right"><a class="btn btn-secondary" href="/ventas/nueva?colaborador=<%= c.idColaborador %>">Elegir</a></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/bottom') %>
