<%- include('../partials/top') %>

<h1>Ventas</h1>
<p class="subtitle">Últimas 200 ventas, todas las sucursales.</p>

<table>
  <thead><tr><th>#</th><th>Fecha</th><th>Sucursal</th><th>Cliente</th><th>Colaborador</th><th>Total</th><th>Estado</th><th></th></tr></thead>
  <tbody>
    <% ventas.forEach(v => { %>
    <tr>
      <td><%= v.idVenta %></td>
      <td><%= new Date(v.fecha_venta).toLocaleString('es-GT') %></td>
      <td><%= v.nombre_sucursal %></td>
      <td><%= v.nombre_cliente %></td>
      <td><%= v.nombre_colaborador %></td>
      <td>Q<%= Number(v.total_venta).toFixed(2) %></td>
      <td><span class="badge <%= v.estado_venta === 'COMPLETADA' ? 'ok' : 'off' %>"><%= v.estado_venta %></span></td>
      <td>
        <% if (v.estado_venta === 'COMPLETADA') { %>
        <form method="post" action="/ventas/<%= v.idVenta %>/anular" style="margin:0;display:flex;gap:0.25rem">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input name="motivo" placeholder="Motivo" required style="width:120px" />
          <button type="submit" class="btn btn-danger" onclick="return confirm('¿Anular esta venta? Se devolverá el stock.');">Anular</button>
        </form>
        <% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/bottom') %>
