<%- include('../partials/top') %>

<h2 class="text-lg font-semibold text-slate-900 mb-5">Registrar compra a proveedor</h2>

<form method="post" action="/compras" class="space-y-6">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <div class="card">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="proveedor" class="field-label">Proveedor</label>
        <select id="proveedor" name="proveedor" required class="field-input">
          <% proveedores.forEach(p => { %><option value="<%= p.idProveedor %>"><%= p.nombre_proveedor %></option><% }) %>
        </select>
      </div>

      <% if (sucursalFija) { %>
        <input type="hidden" name="sucursal" value="<%= sucursalFija %>" />
      <% } else { %>
      <div>
        <label for="sucursal" class="field-label">Sucursal que recibe</label>
        <select id="sucursal" name="sucursal" required class="field-input">
          <% sucursales.forEach(s => { %><option value="<%= s.idSucursal %>"><%= s.nombre_sucursal %></option><% }) %>
        </select>
      </div>
      <% } %>
    </div>
  </div>

  <div class="card">
    <h3 class="font-semibold text-slate-900 mb-4">Productos</h3>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>Producto</th><th class="w-32">Cantidad</th><th class="w-40">Precio compra (Q)</th></tr></thead>
        <tbody>
          <% for (let i = 0; i < lineas; i++) { %>
          <tr>
            <td>
              <select name="producto" class="field-input">
                <option value="">— Producto —</option>
                <% productos.forEach(p => { %><option value="<%= p.idProducto %>"><%= p.nombre_producto %> (<%= p.codigo_sku %>)</option><% }) %>
              </select>
            </td>
            <td><input type="number" name="cantidad" min="1" placeholder="0" class="field-input" /></td>
            <td><input type="number" name="precio" min="0.01" step="0.01" placeholder="0.00" class="field-input" /></td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="flex gap-2">
    <button type="submit" class="btn btn-primary">Registrar compra</button>
    <a class="btn btn-secondary" href="/compras">Cancelar</a>
  </div>
</form>

<%- include('../partials/bottom') %>
