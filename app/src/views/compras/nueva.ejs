<%- include('../partials/top') %>

<h1>Registrar compra a proveedor</h1>

<div class="card">
  <form method="post" action="/compras">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="field">
      <label for="proveedor">Proveedor</label>
      <select id="proveedor" name="proveedor" required>
        <% proveedores.forEach(p => { %><option value="<%= p.idProveedor %>"><%= p.nombre_proveedor %></option><% }) %>
      </select>
    </div>

    <% if (sucursalFija) { %>
      <input type="hidden" name="sucursal" value="<%= sucursalFija %>" />
    <% } else { %>
    <div class="field">
      <label for="sucursal">Sucursal que recibe</label>
      <select id="sucursal" name="sucursal" required>
        <% sucursales.forEach(s => { %><option value="<%= s.idSucursal %>"><%= s.nombre_sucursal %></option><% }) %>
      </select>
    </div>
    <% } %>

    <h3>Productos</h3>
    <% for (let i = 0; i < lineas; i++) { %>
    <div class="linea-detalle">
      <div class="field">
        <select name="producto">
          <option value="">— Producto —</option>
          <% productos.forEach(p => { %><option value="<%= p.idProducto %>"><%= p.nombre_producto %> (<%= p.codigo_sku %>)</option><% }) %>
        </select>
      </div>
      <div class="field"><input type="number" name="cantidad" min="1" placeholder="Cantidad" /></div>
      <div class="field"><input type="number" name="precio" min="0.01" step="0.01" placeholder="Precio compra (Q)" /></div>
    </div>
    <% } %>

    <button type="submit">Registrar compra</button>
    <a class="btn btn-secondary" href="/compras">Cancelar</a>
  </form>
</div>

<%- include('../partials/bottom') %>
