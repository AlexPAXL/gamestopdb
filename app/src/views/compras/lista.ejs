<%- include('../partials/top') %>

<div class="toolbar">
  <h1>Compras a proveedores</h1>
  <a class="btn" href="/compras/nueva">+ Registrar compra</a>
</div>

<table>
  <thead><tr><th>#</th><th>Fecha</th><th>Proveedor</th><th>Sucursal</th><th>Total</th></tr></thead>
  <tbody>
    <% compras.forEach(c => { %>
    <tr>
      <td><%= c.idCompra_Proveedor %></td>
      <td><%= new Date(c.fecha_compra).toLocaleString('es-GT') %></td>
      <td><%= c.nombre_proveedor %></td>
      <td><%= c.nombre_sucursal %></td>
      <td>Q<%= Number(c.total_compra).toFixed(2) %></td>
    </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/bottom') %>
