# Copie este archivo a .env y ajuste los valores antes de producción.
# Las contraseñas de abajo son las que crea sql/11_app_service_accounts.sql
# para desarrollo local; CAMBIELAS en ambos lugares antes de desplegar.

DB_HOST=localhost
DB_NAME=gamestopdb

DB_USER_AUTH=svc_auth
DB_PASS_AUTH="DevOnly#svc_auth_2026"

DB_USER_ADMIN=svc_admin
DB_PASS_ADMIN="DevOnly#svc_admin_2026"

DB_USER_GERENTE=svc_gerente
DB_PASS_GERENTE="DevOnly#svc_gerente_2026"

DB_USER_VENDEDOR=svc_vendedor
DB_PASS_VENDEDOR="DevOnly#svc_vendedor_2026"

DB_USER_AUDITOR=svc_auditor
DB_PASS_AUDITOR="DevOnly#svc_auditor_2026"

# Clave para firmar la cookie de sesión. Genere una propia:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CAMBIAR_ESTA_CLAVE_EN_PRODUCCION"

PORT=3000
NODE_ENV=development
