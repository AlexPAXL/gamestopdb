# Copie este archivo a .env y ajuste los valores antes de producción.
# Las contraseñas de abajo son las que crea sql/11_app_service_accounts.sql
# para desarrollo local; CAMBIELAS en ambos lugares antes de desplegar.

DB_HOST=localhost
DB_NAME=Nombre_bd

DB_USER_AUTH=
DB_PASS_AUTH=""

DB_USER_ADMIN=
DB_PASS_ADMIN=""

DB_USER_GERENTE=
DB_PASS_GERENTE=""

DB_USER_VENDEDOR=
DB_PASS_VENDEDOR=""

DB_USER_AUDITOR=
DB_PASS_AUDITOR=""

# Clave para firmar la cookie de sesión. Genere una propia:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CAMBIAR_ESTA_CLAVE_EN_PRODUCCION"

PORT=3000
NODE_ENV=development
